# Copy to .env if you want to change anything. Every setting is optional for local development.

# Discord webhook (Channel settings > Integrations > Webhooks > Copy Webhook URL).
# Leave empty and digests appear only on the in-app Messages page.
DISCORD_WEBHOOK_URL=

# Database. Defaults to a local SQLite file (backend/db.sqlite3); docker compose uses Postgres.
# DATABASE_URL=postgres://stepboard:stepboard@localhost:5432/stepboard

# Django. Debug is on unless DJANGO_DEBUG=0, and then DJANGO_SECRET_KEY is required.
# DJANGO_DEBUG=1
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Deployment only, behind an HTTPS proxy. Turns on HTTPS redirects, secure cookies and HSTS.
# DJANGO_HTTPS=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://stepboard.example.com

# --- On the production server only (docker-compose.prod.yml; see docs/deployment.md) ---
# The public address Caddy serves and gets an HTTPS certificate for. Also sets ALLOWED_HOSTS and CSRF origins.
# SITE_ADDRESS=159-89-228-242.sslip.io
# Generate each with: python3 -c "import secrets; print(secrets.token_hex(32))"
# POSTGRES_PASSWORD=
# DJANGO_SECRET_KEY=
