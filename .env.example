# Copy to .env and fill in.

# Bot token from the Discord Developer Portal (Bot tab).
DISCORD_TOKEN=

# ID of the family Discord server (right-click the server > Copy Server ID).
DISCORD_GUILD_ID=

# First day that counts, YYYY-MM-DD. Everyone starts at zero on this day.
LAUNCH_DAY=2026-10-12

# Optional.
DATABASE_PATH=stepboard.db
PORT=8000
